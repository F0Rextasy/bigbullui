{
  "name": "bigbullui",
  "version": "0.2.0",
  "description": "Open-source React components you own. Copy-paste friendly, MIT licensed.",
  "license": "MIT",
  "author": "F0Rextasy",
  "homepage": "https://ui.bigbullapp.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F0Rextasy/bigbullui.git"
  },
  "bugs": {
    "url": "https://github.com/F0Rextasy/bigbullui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "typescript",
    "accessible"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./css": {
      "types": "./css.d.ts",
      "default": "./bigbullui.css"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bigbullui": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "src/components/ui",
    "bigbullui.css",
    "css.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-llms-full.mjs && node scripts/calc-sizes.mjs",
    "build": "next build",
    "build:lib": "tsup",
    "prepublishOnly": "npm run build:lib",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/integrity.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "next": "16.3.4",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0"
  }
}
